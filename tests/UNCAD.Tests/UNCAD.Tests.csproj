<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- AutoCAD 2022 涓庢湰鎻掍欢閮芥槸 x64-only锛汚nyCPU 浼氳娴嬭瘯瀹夸富鎸?x86 鍚姩锛?         鍔犺浇 AcDbMgd 澶辫触鍚庢祴璇曡闈欓粯璺宠繃锛? 椤癸級銆?-->
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>13</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- 见 tests.runsettings：本机默认宿主加载不了 x64 AcDbMgd，会让测试被静默跳过。 -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\tests.runsettings</RunSettingsFilePath>
    <RootNamespace>UNCAD.Tests</RootNamespace>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>8.0</AnalysisLevel>
    <AutoCADDir Condition="'$(AutoCADDir)' == ''">D:\Program Files\Autodesk\AutoCAD 2022</AutoCADDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UNCAD\UNCAD.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- UNCAD.dll 鐨?AutoCAD 渚濊禆蹇呴』鐢辨祴璇曢」鐩嚜宸变繚璇?CopyLocal锛?         浠ュ墠闈?杈撳嚭鐩綍閲屾伆濂芥湁杩欏嚑涓?dll"锛屼竴鏃﹀埆鐨勬瀯寤烘竻鐞嗚繃灏变細鍙樻垚
         could not find dependent assembly 'Acdbmgd'锛屾祴璇曢潤榛樿窇 0 椤广€?-->
    <!-- UNCAD.dll 渚濊禆鐨?AutoCAD 鎵樼绋嬪簭闆嗗繀椤荤敱娴嬭瘯椤圭洰鑷繁 CopyLocal锛?         鍚﹀垯娴嬭瘯杈撳嚭鐩綍閲屾病鏈夊畠浠紝娴嬭瘯瀹夸富浼氭姤
         "could not find dependent assembly 'Acdbmgd'" 骞舵妸鍏ㄩ儴娴嬭瘯闈欓粯璺宠繃
         锛堣€?dotnet test 浠嶈繑鍥為€€鍑虹爜 0锛夈€備笉瑕佸姞 PlatformTarget锛氶偅浼氳瀹夸富
         鎸夊彟涓€绉嶄綅鏁板惎鍔紝鍚屾牱瀵艰嚧璺宠繃銆?-->
    <Reference Include="AdWindows"><HintPath>$(AutoCADDir)\AdWindows.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(AutoCADDir)\AcMgd.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AutoCADDir)\AcDbMgd.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCADDir)\AcCoreMgd.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(AutoCADDir)\AcMgd.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AutoCADDir)\AcDbMgd.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCADDir)\AcCoreMgd.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>

