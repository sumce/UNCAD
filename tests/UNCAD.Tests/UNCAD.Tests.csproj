<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- AutoCAD 2022 与本插件都是 x64-only；AnyCPU 会让测试宿主按 x86 启动，
         加载 AcDbMgd 失败后测试被静默跳过（0 项）。 -->
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>13</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>UNCAD.Tests</RootNamespace>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>8.0</AnalysisLevel>
    <AutoCADDir Condition="'$(AutoCADDir)' == ''">D:\Program Files\Autodesk\AutoCAD 2022</AutoCADDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UNCAD\UNCAD.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- UNCAD.dll 的 AutoCAD 依赖必须由测试项目自己保证 CopyLocal：
         以前靠"输出目录里恰好有这几个 dll"，一旦别的构建清理过就会变成
         could not find dependent assembly 'Acdbmgd'，测试静默跑 0 项。 -->
    <Reference Include="AdWindows"><HintPath>$(AutoCADDir)\AdWindows.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(AutoCADDir)\AcMgd.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AutoCADDir)\AcDbMgd.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCADDir)\AcCoreMgd.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
