<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- 3.0 WPF 窗体测试（D-038）需要 WPF 程序集 -->
    <UseWPF>true</UseWPF>
    <!-- AutoCAD 2022 与插件都是 x64-only；AnyCPU 会让测试宿主按 x86 启动，
         加载 AcDbMgd 失败后整个程序集被静默跳过（退出码仍为 0）。 -->
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>13</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- 见 tests.runsettings：本机默认宿主加载不了 x64 AcDbMgd，会让测试被静默跳过。 -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\tests.runsettings</RunSettingsFilePath>
    <RootNamespace>UNCAD.Tests</RootNamespace>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>8.0</AnalysisLevel>
    <AutoCADDir Condition="'$(AutoCADDir)' == ''">D:\Program Files\Autodesk\AutoCAD 2022</AutoCADDir>
    <!-- 托管 CI 没有 AutoCAD：用 Autodesk 官方 NuGet 包把运行时程序集复制到测试输出。
         本地仍用 AutoCADDir，保持与发布构建相同的 DLL 版本。 -->
    <UseAutoCadNuGet Condition="'$(UseAutoCadNuGet)' == ''">false</UseAutoCadNuGet>
    <AutoCadNuGetVersion Condition="'$(AutoCadNuGetVersion)' == ''">24.1.51000</AutoCadNuGetVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- 3.0 WPF 窗体测试（D-038）直接使用 Wpf.Ui 类型 -->
    <PackageReference Include="WPF-UI" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UNCAD\UNCAD.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 真实台账脱敏夹具（tools/FixtureSanitizer 生成，生成时已过泄漏检查）随测试输出复制。 -->
    <None Include="..\Fixtures\*.xlsx" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 本地构建：测试输出目录必须始终带着 AutoCAD 托管程序集。build.ps1 会先
       clean，而 UNCAD.dll 对它们的引用是 Private=False（不复制），于是测试宿主
       会报 Acdbmgd.dll 找不到 —— 轻则整个程序集被静默跳过（门禁假绿），重则
       [FATAL ERROR] 直接中断发布。这里在测试项目构建后显式补齐。 -->
  <ItemGroup Condition="'$(UseAutoCadNuGet)' != 'true'">
    <Reference Include="AdWindows"><HintPath>$(AutoCADDir)\AdWindows.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(AutoCADDir)\AcMgd.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AutoCADDir)\AcDbMgd.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCADDir)\AcCoreMgd.dll</HintPath><Private>True</Private></Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseAutoCadNuGet)' == 'true'">
    <PackageReference Include="AutoCAD.NET" Version="$(AutoCadNuGetVersion)" />
    <PackageReference Include="AutoCAD.NET.Core" Version="$(AutoCadNuGetVersion)" />
    <PackageReference Include="AutoCAD.NET.Model" Version="$(AutoCadNuGetVersion)" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <Target Name="CopyAutoCadAssemblies" AfterTargets="Build"
          Condition="'$(UseAutoCadNuGet)' != 'true'">
    <ItemGroup>
      <AutoCadAssembly Include="$(AutoCADDir)\Ac*.dll" />
      <AutoCADAssembly Include="$(AutoCADDir)\AdWindows.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(AutoCadAssembly)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
