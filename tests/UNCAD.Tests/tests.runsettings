<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- 本机默认 VSTest 宿主在以独立 AppDomain 加载测试程序集时，需要测试输出目录里
         直接存在 x64 的 AcDbMgd 等程序集；缺失时 xunit 会把整个程序集**静默跳过**
         且 dotnet test 仍返回退出码 0 —— 发布门禁会假绿。
         禁用 AppDomain 后测试在 testhost 默认域中加载，配合测试项目里
         CopyAutoCadAssemblies 目标（构建后把 Ac*.dll/AdWindows.dll 复制到输出），
         实测 1058/1058 全部执行（与源码统计一致：663 [Fact] + 395 [InlineData]）。 -->
    <DisableAppDomain>true</DisableAppDomain>
  </RunConfiguration>
</RunSettings>
