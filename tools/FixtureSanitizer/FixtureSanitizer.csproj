<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- 台账原件很大（单个 sheet 解压 24MB），DOM 重写需要大量内存：强制 x64。 -->
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>FixtureSanitizer</RootNamespace>
    <AssemblyName>FixtureSanitizer</AssemblyName>
    <IsPackable>false</IsPackable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 与 src/UNCAD/UNCAD.csproj 保持同一 NPOI 版本，保证读写行为一致。 -->
    <PackageReference Include="NPOI" Version="2.5.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- 清洗包级别部件（docProps/customXml/sheet 名）用 zip 级后处理。 -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

</Project>
