<ui:FluentWindow x:Class="UNCAD.UiDemo.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:UNCAD.UiDemo.Pages"
                 Title="UNCAD 3.0 — UI Demo（WPF · Fluent）"
                 Width="1360" Height="860" MinWidth="1080" MinHeight="660"
                 WindowStartupLocation="Manual" Left="60" Top="60"
                 FontFamily="Microsoft YaHei UI, Segoe UI"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="UNCAD 3.0 — UI Demo" />

        <ui:NavigationView x:Name="Navi"
                           Grid.Row="1"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           IsPaneOpen="True"
                           PaneDisplayMode="Left"
                           PaneTitle="UNCAD 3.0"
                           OpenPaneLength="216"
                           Background="{DynamicResource ApplicationBackgroundBrush}"
                           ItemInvoked="OnNavItemInvoked">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="设置中心" TargetPageType="{x:Type pages:SettingsPage}"
                                       Icon="{ui:SymbolIcon Settings24}" />
                <ui:NavigationViewItem Content="清单评审 U1F" TargetPageType="{x:Type pages:FillReviewPage}"
                                       Icon="{ui:SymbolIcon Document24}" />
                <ui:NavigationViewItem Content="批量确认 U1U" TargetPageType="{x:Type pages:BatchConfirmPage}"
                                       Icon="{ui:SymbolIcon CheckmarkCircle24}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="登录窗口" Tag="login"
                                       Icon="{ui:SymbolIcon Person24}" />
                <ui:NavigationViewItem Content="切换深浅色" Tag="theme"
                                       Icon="{ui:SymbolIcon Color24}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
