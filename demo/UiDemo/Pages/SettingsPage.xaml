<UserControl x:Class="UNCAD.UiDemo.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,36,32">
        <StackPanel MaxWidth="920" HorizontalAlignment="Left">

            <TextBlock Text="设置中心" FontSize="26" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Margin="2,6,0,18" FontSize="13"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="U1SET · 配置快照在命令开始时一次读取，预览与写入使用同一份参数" />

            <ui:InfoBar Title="UI Demo" IsOpen="True" IsClosable="False" Severity="Informational"
                        Margin="0,0,0,16"
                        Message="独立演示程序（WPF-UI 库 / net48 实测运行）。交互为示意，数据为示例，不代表最终功能。" />

            <!-- 概览：三张统计卡 -->
            <TextBlock Text="概览" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <ui:Card Grid.Column="0" Margin="0,0,10,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="版本" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="UNCAD 3.0.0" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,2" />
                        <TextBlock Text="AutoCAD 2022 · x64 · .NET Framework 4.8" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Grid.Column="1" Margin="0,0,10,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="授权" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="已激活 · 企业版" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,2" />
                        <TextBlock Text="账户验证模式 · 到期 2027-06-30" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Grid.Column="2" Padding="16">
                    <StackPanel>
                        <TextBlock Text="最近输出" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="12 台机台" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,2" />
                        <TextBlock Text="BOQ 12 · DWG 12 · PDF 36" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- 输出 -->
            <TextBlock Text="输出" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:Card Margin="0,0,0,20" Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="输出根目录" FontSize="13" />
                            <TextBlock FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="默认：我的文档\UNCAD输出" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:TextBox Text="D:\项目\北京二次配\输出" Width="300" />
                            <ui:Button Content="浏览" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Separator Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,4,0,12" />
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="分层输出布局（输出根\图纸\类型\机台）" VerticalAlignment="Center" FontSize="13" />
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="True" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="写入前检查目标占用（锁定的文件在 CAD 事务前拦截）" VerticalAlignment="Center" FontSize="13" />
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="True" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="U1PDF 按回路导出彩色 PDF" VerticalAlignment="Center" FontSize="13" />
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="True" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- 电缆预留规则 -->
            <TextBlock Text="电缆预留规则" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:Card Margin="0,0,0,20" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,14">
                        <TextBlock Text="业主统一预留 (mm)" FontSize="13" Margin="0,0,0,6" />
                        <ui:NumberBox Value="3000" Minimum="0" Maximum="100000"
                                      SpinButtonPlacementMode="Compact" ClearButtonEnabled="False" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Text="I-Line 盘内预留 (mm)" FontSize="13" Margin="0,0,0,6" />
                        <ui:NumberBox Value="3400" Minimum="0" Maximum="100000"
                                      SpinButtonPlacementMode="Compact" ClearButtonEnabled="False" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,14">
                        <TextBlock Text="插座盘盘内预留 (mm)" FontSize="13" Margin="0,0,0,6" />
                        <ui:NumberBox Value="1000" Minimum="0" Maximum="100000"
                                      SpinButtonPlacementMode="Compact" ClearButtonEnabled="False" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Text="插接箱箱内预留 (mm)" FontSize="13" Margin="0,0,0,6" />
                        <ui:NumberBox Value="500" Minimum="0" Maximum="100000"
                                      SpinButtonPlacementMode="Compact" ClearButtonEnabled="False" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="设备内预留不在此处填写：首次在清单确认窗口填写（默认 0），确认后写入 frameinfo_json，后续 U1U 自动预填；老图无记录时仍会询问。" />
                </Grid>
            </ui:Card>

            <!-- 外观 -->
            <TextBlock Text="外观" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:Card Margin="0,0,0,20" Padding="16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="主题" VerticalAlignment="Center" FontSize="13" Margin="0,0,16,0" />
                    <ui:Button x:Name="LightBtn" Content="浅色" Margin="0,0,10,0"
                                       Click="OnLightClick" />
                    <ui:Button x:Name="DarkBtn" Content="深色"
                                       Click="OnDarkClick" />
                </StackPanel>
            </ui:Card>

            <!-- 日志与记录 -->
            <TextBlock Text="日志与记录" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:Card Margin="0,0,0,8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="日志级别" FontSize="13" Margin="0,0,0,6" />
                        <ComboBox SelectedIndex="1" Width="120">
                            <ComboBoxItem Content="DEBUG" />
                            <ComboBoxItem Content="INFO" />
                            <ComboBoxItem Content="WARN" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="日志保留 (天)" FontSize="13" Margin="0,0,0,6" />
                        <ui:NumberBox Value="30" Minimum="1" Maximum="365" Width="120"
                                      SpinButtonPlacementMode="Compact" ClearButtonEnabled="False" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="操作记录保留 (月)" FontSize="13" Margin="0,0,0,6" />
                        <ui:NumberBox Value="6" Minimum="1" Maximum="36" Width="120"
                                      SpinButtonPlacementMode="Compact" ClearButtonEnabled="False" />
                    </StackPanel>
                    <ui:Button Grid.Column="4" Content="打开日志目录" VerticalAlignment="Bottom"
                               Icon="{ui:SymbolIcon Folder24}" />
                </Grid>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
