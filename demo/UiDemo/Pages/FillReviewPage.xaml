<UserControl x:Class="UNCAD.UiDemo.Pages.FillReviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="28,20,36,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 + 机台信息 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="清单评审" FontSize="26" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <StackPanel Orientation="Horizontal" Margin="2,6,0,0">
                <Border CornerRadius="10" Padding="10,3" Margin="0,0,8,0"
                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="机台 M-2F-01" FontSize="12" Foreground="White" />
                </Border>
                <Border CornerRadius="10" Padding="10,3" Margin="0,0,8,0"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <TextBlock Text="注塑机 · 海天 MA1600" FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Border>
                <Border CornerRadius="10" Padding="10,3" Margin="0,0,8,0"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <TextBlock Text="图纸 BJ-2F-DWG-003" FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Border>
                <Border CornerRadius="10" Padding="10,3"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <TextBlock Text="回路 5 / 5（齐全）" FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Border>
            </StackPanel>
        </StackPanel>

        <ui:InfoBar Grid.Row="1" Margin="0,0,0,12" IsOpen="True" IsClosable="False"
                    Severity="Success" Title="自动匹配完成"
                    Message="7 项来自固定清单自动生成，1 项手动添加；未匹配条目已禁用，不会进入最终写入。" />

        <!-- 清单表格 -->
        <Border Grid.Row="2" CornerRadius="8" Padding="0"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <DataGrid ItemsSource="{Binding}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderThickness="0" IsReadOnly="False"
                      RowHeight="38" FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="No." Binding="{Binding No}" Width="50" IsReadOnly="True" />
                    <DataGridTextColumn Header="类" Binding="{Binding Category}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="编码" Binding="{Binding Code}" Width="90" IsReadOnly="True" />
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" IsReadOnly="False" />
                    <DataGridTextColumn Header="型号 / 特征" Binding="{Binding Model}" Width="240" IsReadOnly="False" />
                    <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="56" IsReadOnly="True" />
                    <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="80" IsReadOnly="False" />
                    <DataGridTemplateColumn Header="来源" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="10,2" HorizontalAlignment="Left"
                                        Background="{Binding SourceBrush}" ToolTip="{Binding SourceNote}">
                                    <TextBlock Text="{Binding Source}" FontSize="12" Foreground="White" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- CABLE_INFO 公式 -->
        <ui:Card Grid.Row="3" Margin="0,14,0,0" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CABLE_INFO（写入图框 · 全部 mm）" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap"
                               FontFamily="Cascadia Mono, Consolas"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="电缆ZB-YJVR-5*4mm²: 1000+700+3400（盘内）+2000（设备内）+3000（预留）=10100mm" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="24,0,0,0" Width="220">
                    <TextBlock Text="设备内预留 (mm)" FontSize="13" Margin="0,0,0,6" />
                    <ui:NumberBox Value="2000" Minimum="0" Maximum="100000"
                                  SpinButtonPlacementMode="Compact" ClearButtonEnabled="False" />
                    <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="确认后写入 frameinfo_json，后续 U1U 自动预填" />
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
