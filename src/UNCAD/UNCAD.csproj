<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>13</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>8.0</AnalysisLevel>
    <RootNamespace>UNCAD</RootNamespace>
    <AssemblyName>UNCAD</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AutoCADDir Condition="'$(AutoCADDir)' == ''">D:\Program Files\Autodesk\AutoCAD 2022</AutoCADDir>

    <AssemblyTitle>UNCAD - AutoCAD 轻量插件集</AssemblyTitle>
    <AssemblyDescription>AutoCAD 2022 U1 命令集：清单生成、批量更新、自动记录、绘制与统计</AssemblyDescription>
    <AssemblyCompany>UNSIAO.Ltd</AssemblyCompany>
    <AssemblyVersion>3.5.0.1</AssemblyVersion>
    <FileVersion>3.5.0.1</FileVersion>
    <Version>3.5.0</Version>
    <BuildTimestampCompact>$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</BuildTimestampCompact>
    <InformationalVersion>$(Version)+build.$(BuildTimestampCompact)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- VS 调试：F5 启动 AutoCAD 2022 并附加调试器 -->
    <StartAction>Program</StartAction>
    <StartProgram>$(AutoCADDir)\acad.exe</StartProgram>
    <StartWorkingDirectory>$(AutoCADDir)</StartWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <None Update="BOQ模板.xlsx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="BOQ_Template.xlsx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Resources\XFrameTemplate.dwg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AcMgd">
      <HintPath>$(AutoCADDir)\AcMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AutoCADDir)\AcDbMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AutoCADDir)\AcCoreMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>$(AutoCADDir)\AdWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="NPOI" Version="2.5.6" />
    <!-- 3.0 UI（D-038）：全部窗体迁 WPF + WPF-UI Fluent 库 -->
    <PackageReference Include="WPF-UI" Version="4.0.2" />
    <ProjectReference Include="..\UNCAD.Preview\UNCAD.Preview.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Ribbon 与 3.0 WPF 窗体共用 WPF（自动引入 WindowsBase/Presentation*/System.Xaml） -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Icons\*.svg" />
    <EmbeddedResource Include="Assets\unsiao-mark.png" />
    <!-- 内嵌固定清单：随插件发布，用户无需提供清单 Excel -->
    <EmbeddedResource Include="Resources\embedded_catalog.tsv" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF 程序集由 UseWPF 自动引入（原 Ribbon 手工引用已合并） -->
  </ItemGroup>

  <Target Name="CheckAutoCADReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(AutoCADDir)\AcMgd.dll')"
           Text="未找到 AutoCAD 2022 .NET API（$(AutoCADDir)\AcMgd.dll）。请安装 AutoCAD 2022，或用 -p:AutoCADDir=... 指定路径。" />
  </Target>

  <Target Name="CopyWebPreview" AfterTargets="Build">
    <ItemGroup>
      <PreviewExecutable Include="$(MSBuildProjectDirectory)\..\UNCAD.Preview\bin\$(Configuration)\net48\UNCAD.Preview.exe*" Exclude="**\*.pdb" />
      <PreviewAsset Include="$(MSBuildProjectDirectory)\..\UNCAD.Preview\Web\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PreviewExecutable)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PreviewAsset)" DestinationFiles="@(PreviewAsset->'$(OutDir)Web\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
