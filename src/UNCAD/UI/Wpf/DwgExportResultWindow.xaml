<ui:FluentWindow x:Class="UNCAD.UI.DwgExportResultWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="U1DWG · 导出结果"
                 Width="900" Height="520" MinWidth="700" MinHeight="380"
                 FontFamily="Microsoft YaHei UI, Segoe UI"
                 WindowBackdropType="None" WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True" ResizeMode="CanResize"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="U1DWG · 导出结果" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="24,10,24,4">
            <TextBlock FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="{Binding Heading, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}, Mode=OneWay}" />
            <WrapPanel x:Name="BadgeBar" x:FieldModifier="internal" Margin="4,8,0,0" />
            <TextBlock Margin="2,2,0,0" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="每个机台一个 DWG，与 BOQ / PDF 在同一个机台文件夹里；交付时把机台文件夹整个发出去即可。" />
        </StackPanel>

        <DataGrid x:Name="RowsGrid" Grid.Row="2" Margin="24,12,24,8"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  BorderThickness="0" RowHeight="32" FontSize="13"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  Background="{DynamicResource ControlFillColorDefaultBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="机台 ID" Binding="{Binding MachineId}" Width="120" />
                <DataGridTextColumn Header="图框" Binding="{Binding Frames}" Width="64">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="回路数" Binding="{Binding CircuitCount}" Width="64">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="回路" Binding="{Binding CircuitsText}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding CircuitsText}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="DWG 文件" Binding="{Binding FilePath}" Width="2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding FilePath}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="24,8,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding Footer, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}, Mode=OneWay}" />
            <ui:Button x:Name="OpenFolderButton" Grid.Column="1" Content="打开输出目录"
                       MinWidth="110" Margin="0,0,10,0"
                       Icon="{ui:SymbolIcon FolderOpen24}" Click="OnOpenFolder" />
            <ui:Button x:Name="CloseButton" Grid.Column="2" Content="关闭" MinWidth="100"
                       IsCancel="True" IsDefault="True" Click="OnClose" />
        </Grid>
    </Grid>
</ui:FluentWindow>
