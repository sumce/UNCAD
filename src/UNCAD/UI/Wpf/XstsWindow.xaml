<ui:FluentWindow x:Class="UNCAD.UI.XstsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="XSTS · 机台回路统计"
                 Width="920" Height="600" MinWidth="720" MinHeight="440"
                 FontFamily="Microsoft YaHei UI, Segoe UI"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="XSTS · 机台回路统计" />

        <StackPanel Grid.Row="1" Margin="24,10,24,4">
            <TextBlock FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="{Binding Heading, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}, Mode=OneWay}" />
            <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding Coverage, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}, Mode=OneWay}" />
            <WrapPanel x:Name="BadgeBar" x:FieldModifier="internal" Margin="4,8,0,0" />
            <TextBlock Margin="2,2,0,0" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding NextStep, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}, Mode=OneWay}" />
        </StackPanel>

        <TabControl x:Name="ReportTabs" Grid.Row="2" Margin="24,12,24,8">
            <TabItem Header="回路统计">
                <DataGrid x:Name="MachineGrid" Margin="0,8,0,0"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderThickness="0"
                          RowHeight="32" FontSize="13"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="机台 ID" Binding="{Binding MachineId}" Width="110" />
                        <DataGridTextColumn Header="批次" Binding="{Binding Batch}" Width="90" />
                        <DataGridTextColumn Header="序号" Binding="{Binding Seq}" Width="70" />
                        <DataGridTextColumn Header="已选回路" Binding="{Binding SelectedCircuitCount}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="应有回路" Binding="{Binding ExpectedCircuitText}" Width="90" />
                        <DataGridTextColumn Header="缺少回路" Binding="{Binding MissingText}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding MissingText}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="多出回路" Binding="{Binding UnexpectedText}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding UnexpectedText}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem x:Name="IssueTab" Header="异常图框">
                <DataGrid x:Name="IssueGrid" Margin="0,8,0,0"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderThickness="0"
                          RowHeight="32" FontSize="13"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="图框" Binding="{Binding FrameNumber}" Width="60" />
                        <DataGridTextColumn Header="机台 ID" Binding="{Binding MachineId}" Width="120" />
                        <DataGridTextColumn Header="回路名称" Binding="{Binding CircuitName}" Width="*" />
                        <DataGridTextColumn Header="问题" Binding="{Binding Description}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Description}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem x:Name="BlindTab" Header="未上图机台">
                <DataGrid x:Name="BlindGrid" Margin="0,8,0,0"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderThickness="0"
                          RowHeight="32" FontSize="13"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="机台 ID" Binding="{Binding MachineId}" Width="130" />
                        <DataGridTextColumn Header="批次" Binding="{Binding Batch}" Width="90" />
                        <DataGridTextColumn Header="序号" Binding="{Binding Seq}" Width="70" />
                        <DataGridTextColumn Header="近名提示（疑似画错名）" Binding="{Binding NearNameNote}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding NearNameNote}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="24,8,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding Footer, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}, Mode=OneWay}" />
            <ui:Button x:Name="CloseButton" Grid.Column="1" Content="关闭" MinWidth="100"
                       IsCancel="True" IsDefault="True" Click="OnClose" />
        </Grid>
    </Grid>
</ui:FluentWindow>
