<ui:FluentWindow x:Class="UNCAD.UI.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="UNCAD · 关于与授权"
                 Width="880" Height="640" MinWidth="720" MinHeight="520"
                 FontFamily="Microsoft YaHei UI, Segoe UI"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="关于与授权" />

        <Grid Grid.Row="1" Margin="24,12,24,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- P7 品牌页头：品牌标志 + 产品名 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Grid Width="42" Height="42" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="6" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="4" Background="#FF0070AD">
                        <TextBlock Text="U" FontSize="22" FontWeight="Bold" Foreground="White"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Row="1" Margin="0,2,0,0" CornerRadius="2"
                            Background="#FFEC7E22" />
                </Grid>
                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="ProductTitle" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="ProductSubtitle" FontSize="12" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- 左侧导航 + 右侧内容 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ListBox x:Name="NavList" Grid.Column="0" Margin="0,0,16,0"
                         BorderThickness="0" Background="Transparent"
                         SelectionChanged="OnNavSelected">
                    <ListBoxItem Content="概览" Tag="overview" />
                    <ListBoxItem Content="更新记录" Tag="updates" />
                    <ListBoxItem Content="使用条款" Tag="terms" />
                </ListBox>

                <Grid Grid.Column="1">
                    <!-- 概览：授权 / 产品 / 命令统计 / 公司 卡片 -->
                    <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <ui:Card x:Name="AuthorizationCard" Margin="0,0,0,12" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="授权信息" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="AuthorizationStatus" Margin="0,4,0,12"
                                               FontSize="20" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                                            <TextBlock Text="授权模式" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="LicenseModeText" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                            <TextBlock Text="有效期至" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="LicenseExpiryText" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12">
                                            <TextBlock Text="剩余天数" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="LicenseDaysText" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                                            <TextBlock Text="授权公司" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="LicenseeCompanyText" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="授权客户" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="LicenseeNameText" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1">
                                            <TextBlock Text="预计授权时间" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="ExpectedYearsText" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LicenseFooter" Grid.Column="0"
                                                   VerticalAlignment="Center" FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ui:Button x:Name="LoginButton" Grid.Column="1"
                                                   Content="账号登录" MinWidth="96" Margin="12,0,0,0"
                                                   Visibility="Collapsed"
                                                   Icon="{ui:SymbolIcon Person24}"
                                                   Click="OnLogin" />
                                    </Grid>
                                </StackPanel>
                            </ui:Card>

                            <ui:Card Margin="0,0,0,12" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="产品信息" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                                            <TextBlock Text="产品" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="ProductNameText" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                            <TextBlock Text="版本" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="VersionText" FontSize="13" FontWeight="SemiBold"
                                                       FontFamily="Cascadia Mono, Consolas" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12">
                                            <TextBlock Text="构建时间" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="BuildTimeText" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                                            <TextBlock Text="发行日期" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="UpdatedOnText" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="客户代码" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="CustomerCodeText" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1">
                                            <TextBlock Text="开发者" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="CompanyText" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>

                            <ui:Card x:Name="CommandStatsCard" Margin="0,0,0,12" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="命令统计" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
                                        <StackPanel Margin="0,0,32,0">
                                            <TextBlock x:Name="FeatureCountText" FontSize="24" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="功能模块" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock x:Name="CommandCountText" FontSize="24" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="注册命令" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="CommandSummaryText" FontSize="11"
                                               TextWrapping="Wrap" LineHeight="18"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </ui:Card>

                            <ui:Card Padding="20">
                                <StackPanel>
                                    <TextBlock Text="UNSIAO.Ltd" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                                            <TextBlock Text="公司" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="CompanyNameText" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                            <TextBlock Text="版权" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="CopyrightText" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="官网" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="WebsiteText" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock Text="链接" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="WebsiteLink" FontSize="13" Cursor="Hand"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       MouseLeftButtonUp="OnWebsiteClick" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 更新记录：与更新日志弹窗同一面板 -->
                    <local:VersionNotesView x:Name="UpdatesPage" Visibility="Collapsed"
                                            xmlns:local="clr-namespace:UNCAD.UI" />

                    <!-- 使用条款 -->
                    <ScrollViewer x:Name="TermsPage" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="8" Padding="20">
                            <TextBlock x:Name="TermsText" FontSize="12" LineHeight="22"
                                       TextWrapping="Wrap" />
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="24,8,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding Footer, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}, Mode=OneWay}" />
            <ui:Button Grid.Column="1" x:Name="CloseButton" Content="关闭" MinWidth="110"
                       IsDefault="True" IsCancel="True" Click="OnClose" />
        </Grid>
    </Grid>
</ui:FluentWindow>
