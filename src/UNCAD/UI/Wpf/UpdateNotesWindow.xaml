<ui:FluentWindow x:Class="UNCAD.UI.UpdateNotesWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="UNCAD 已更新"
                 Width="760" Height="540" MinWidth="620" MinHeight="420"
                 FontFamily="Microsoft YaHei UI, Segoe UI"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="更新说明" />

        <Grid Grid.Row="1" Margin="24,12,24,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="{Binding Heading, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}, Mode=OneWay}" />
            <TextBlock Grid.Row="1" Margin="0,6,0,12" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="选择左侧版本查看更新详情；U1A 可随时查看全部版本记录。" />
            <local:VersionNotesView Grid.Row="2" x:Name="Notes"
                                    xmlns:local="clr-namespace:UNCAD.UI" />
        </Grid>

        <Grid Grid.Row="2" Margin="24,8,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="查看后不再自动弹出；如需回顾请运行 U1A。" />
            <ui:Button Grid.Column="1" x:Name="CloseButton" Content="知道了" MinWidth="110"
                       Appearance="Primary"
                       IsDefault="True" IsCancel="True" Click="OnClose" />
        </Grid>
    </Grid>
</ui:FluentWindow>
