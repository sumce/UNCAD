<ui:FluentWindow x:Class="UNCAD.UI.ClientLoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="UNCAD Pro 在线登录"
                 Width="460" Height="720" MinWidth="420" MinHeight="520"
                 ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
                 FontFamily="Microsoft YaHei UI, Segoe UI"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="在线登录" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="32,8,32,8">
            <TextBlock FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="在线登录" />
            <TextBlock Margin="0,6,0,14" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="使用 UNCAD 账号登录并在此设备上线" />

            <TextBlock Text="UNCAD 账号" FontSize="13" Margin="0,0,0,6"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:TextBox x:Name="Account" FontSize="14"
                        TextChanged="OnAccountTextChanged" />

            <ui:InfoBar x:Name="LoginStatus" Margin="0,14,0,0"
                        IsOpen="True" IsClosable="False" Severity="Informational"
                        Message="正在准备登录页面..." />
        </StackPanel>

        <!-- 登录页宿主：WebView2（WPF 控件）在代码里挂载；不可用时替换为降级说明。 -->
        <Grid Grid.Row="2" x:Name="BrowserHost" Margin="0,4,0,0" ClipToBounds="True">
            <Border x:Name="UnavailablePanel" Visibility="Collapsed"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Margin="16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="UnavailableMessage" FontSize="13"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="32,8,32,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" x:Name="CancelButton" Content="取消"
                       MinWidth="88" IsCancel="True" Click="OnCancel" />
            <ui:Button Grid.Column="1" x:Name="ManualButton" Content="手动输入"
                       Margin="12,0,0,0" MinWidth="88" Visibility="Collapsed"
                       Click="OnManualCode" />
            <ui:Button Grid.Column="2" x:Name="ReloadButton" Content="重新登录"
                       HorizontalAlignment="Right" Margin="12,0,0,0" MinWidth="88"
                       Click="OnReloadLogin" />
            <ui:Button Grid.Column="3" x:Name="ActivateButton" Content="在此设备上线"
                       Appearance="Primary" Margin="12,0,0,0" MinWidth="112"
                       IsDefault="True" Click="OnActivateOnThisDevice" />
        </Grid>
    </Grid>
</ui:FluentWindow>
