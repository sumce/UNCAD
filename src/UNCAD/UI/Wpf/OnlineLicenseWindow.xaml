<ui:FluentWindow x:Class="UNCAD.UI.OnlineLicenseWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="UNCAD Pro 在线授权"
                 Width="440" Height="520" MinWidth="400" MinHeight="460"
                 ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
                 FontFamily="Microsoft YaHei UI, Segoe UI"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="在线授权" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="32,12,32,8">
            <TextBlock FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="验证此设备的授权" />
            <TextBlock Margin="0,6,0,16" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="WebView2 不可用时的兜底入口：输入账号并验证本机在线授权。" />

            <TextBlock Text="账号" FontSize="13" Margin="0,0,0,6"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:TextBox x:Name="AuthorizationCode" FontSize="14" />

            <ui:InfoBar x:Name="Status" Margin="0,16,0,0"
                        IsOpen="True" IsClosable="False" Severity="Warning" />

            <TextBlock Margin="0,12,0,12" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="客户信息和授权期限会从在线授权响应中读取。" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="32,8,32,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" x:Name="SaveButton" Content="验证并保存"
                       Appearance="Primary" HorizontalAlignment="Stretch"
                       Icon="{ui:SymbolIcon CheckmarkCircle24}" Padding="0,10"
                       IsDefault="True" Click="OnValidateAndSave" />
            <ui:Button Grid.Column="1" x:Name="CancelButton" Content="稍后处理"
                       Margin="12,0,0,0" MinWidth="96"
                       IsCancel="True" Click="OnCancel" />
        </Grid>
    </Grid>
</ui:FluentWindow>
