<ui:FluentWindow x:Class="UNCAD.UI.U1L3DPreviewWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="U1L3D 三维预览"
                 Width="1180" Height="760" MinWidth="900" MinHeight="600"
                 ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 FontFamily="Microsoft YaHei UI, Segoe UI"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="U1L3D 三维预览" ShowMinimize="False" />

        <!-- WebView2（WPF 控件）在代码里挂载；致命错误时整块替换为错误说明。 -->
        <Grid Grid.Row="1" x:Name="BrowserHost" ClipToBounds="True">
            <Border x:Name="ErrorPanel" Visibility="Collapsed"
                    Background="{DynamicResource ApplicationBackgroundBrush}">
                <TextBlock x:Name="ErrorMessage" FontSize="14" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="32"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="24,8,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="只读预览：不写 CAD 实体、不刷新工作簿、不访问网络（D-025/D-033）。" />
            <ui:Button Grid.Column="1" x:Name="CloseButton" Content="关闭"
                       MinWidth="96" IsCancel="True" Click="OnClose" />
        </Grid>
    </Grid>
</ui:FluentWindow>
