<UserControl x:Class="UNCAD.UI.SettingsColorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:kit="clr-namespace:UNCAD.UI"
             FontFamily="Microsoft YaHei UI, Segoe UI">
    <!-- NavigationView 的 Frame 不继承窗口资源，设计令牌按页合并（2026-11-03）。 -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <kit:FluentKit />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="CadColorChoiceTemplate">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="20" Height="14" RadiusX="2" RadiusY="2"
                               Fill="{Binding PreviewBrush}"
                               Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13"
                               Text="{Binding DisplayName}" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,36,32">
        <StackPanel MaxWidth="920" HorizontalAlignment="Left">

            <TextBlock Style="{DynamicResource UncadPageTitle}" Text="颜色" />
            <TextBlock Margin="2,6,0,18" Style="{DynamicResource UncadCaption}"
                       Text="块的标注颜色（ACI 色号）" />

            <ui:Card Style="{DynamicResource UncadCard}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource UncadSectionTitle}" Text="块颜色" />
                    <TextBlock Margin="0,4,0,12" Style="{DynamicResource UncadCaption}"
                               Text="设备端包含 Downstream 块；修改后对所有后续命令生效。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="设备端颜色"
                                       ToolTip="U1F/U1U 用于设备块和设备轴位块（DS）的 AutoCAD ACI 颜色。" />
                            <ComboBox x:Name="DeviceColorBox" x:FieldModifier="internal"
                                      Style="{DynamicResource UncadCombo}"
                                      ItemTemplate="{StaticResource CadColorChoiceTemplate}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="上游端颜色"
                                       ToolTip="U1F/U1U 用于 upstream、上游信息/编号块和上游轴位块（US）的 AutoCAD ACI 颜色。" />
                            <ComboBox x:Name="UpstreamColorBox" x:FieldModifier="internal"
                                      Style="{DynamicResource UncadCombo}"
                                      ItemTemplate="{StaticResource CadColorChoiceTemplate}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
