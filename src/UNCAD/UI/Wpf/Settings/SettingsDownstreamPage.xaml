<UserControl x:Class="UNCAD.UI.SettingsDownstreamPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:kit="clr-namespace:UNCAD.UI"
             FontFamily="Microsoft YaHei UI, Segoe UI">
    <!-- NavigationView 的 Frame 不继承窗口资源，设计令牌按页合并（2026-11-03）。 -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Frame 资源黑洞（D-046 复盘）：页面必须自带 WPF-UI 字典，
                     否则 ToggleSwitch/NumberBox 退化为兜底模板（蓝条/无微调按钮）。
                     主题目前只在窗口构造时确定；若将来加运行时换肤，
                     需同步刷新各页的 ThemesDictionary。 -->
                <kit:FluentKit />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,36,32">
        <StackPanel MaxWidth="920" HorizontalAlignment="Left">

            <TextBlock Style="{DynamicResource UncadPageTitle}" Text="Downstream 自动添加" />
            <TextBlock Margin="2,6,0,18" Style="{DynamicResource UncadCaption}"
                       Text="下游端 Downstream 块（精确块名）按可见性状态自动补清单" />

            <!-- 自动添加开关（独立） -->
            <ui:Card Style="{DynamicResource UncadCard}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource UncadSectionTitle}" Text="自动添加开关（独立）" />
                    <TextBlock Margin="0,4,0,4" Style="{DynamicResource UncadCaption}"
                               Text="这两项只控制 Downstream 块自己的自动添加，与「清单与表格」里的通用类别开关互不影响：通用开关只管上游规则。所以可以做到“只开 Downstream、不开上游”。" />
                    <StackPanel>
                        <ui:ToggleSwitch x:Name="DownstreamSocketEnabled" x:FieldModifier="internal"
                                         Style="{DynamicResource UncadToggle}" Content="socket box 自动添加" />
                        <TextBlock Style="{DynamicResource UncadToggleHint}"
                                   Text="Downstream 块状态为 socket box 时，额外加一行 4.x 插座箱/盘（额定电流见下方）。" />
                    </StackPanel>
                    <StackPanel>
                        <ui:ToggleSwitch x:Name="DownstreamPanelEnabled" x:FieldModifier="internal"
                                         Style="{DynamicResource UncadToggle}" Content="I-line_Panel 自动添加" />
                        <TextBlock Style="{DynamicResource UncadToggleHint}"
                                   Text="Downstream 块状态为 I-line_Panel 时，额外加一行电盘；永不带断路器（断路器只由上游 I-Line盘 产生）。" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- 额定电流 -->
            <ui:Card Style="{DynamicResource UncadCard}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource UncadSectionTitle}" Text="额定电流" />
                    <TextBlock Margin="0,4,0,12" Style="{DynamicResource UncadCaption}"
                               Text="不从 U_配电信息 提取：那是盘柜主开关电流，会导致整行未匹配。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="插座箱额定电流（A）"
                                       ToolTip="下游 Downstream 块状态为 socket box 时，额外那一行 4.x 插座盘使用的额定电流（默认 20A；与 U_配电信息里的盘柜电流无关）。" />
                            <ui:NumberBox x:Name="FillDownstreamAmps" x:FieldModifier="internal"
                                          Style="{DynamicResource UncadNumberBox}"
                                          Minimum="1" Maximum="1000"
                                          ToolTip="下游 Downstream 块状态为 socket box 时，额外那一行 4.x 插座盘使用的额定电流（默认 20A；与 U_配电信息里的盘柜电流无关）。" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="电盘额定电流（A）"
                                       ToolTip="下游 Downstream 块状态为 I-line_Panel 时，额外那一行电盘使用的额定电流（默认 1000A）。这一行不会带断路器。" />
                            <ui:NumberBox x:Name="FillDownstreamPanelAmps" x:FieldModifier="internal"
                                          Style="{DynamicResource UncadNumberBox}"
                                          Minimum="1" Maximum="10000"
                                          ToolTip="下游 Downstream 块状态为 I-line_Panel 时，额外那一行电盘使用的额定电流（默认 1000A）。这一行不会带断路器。" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- 三态规则 -->
            <ui:Card Style="{DynamicResource UncadCard}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource UncadSectionTitle}" Text="三态规则" />
                    <TextBlock Margin="0,4,0,12" Style="{DynamicResource UncadCaption}"
                               Text="与 upstream 共用同一套可见性状态。" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{DynamicResource UncadBodyStrong}" Text="socket box" />
                        <TextBlock Grid.Column="1" Style="{DynamicResource UncadBody}"
                                   Text="额外一行 4.x 插座箱/盘（受“插座盘”开关控制）" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{DynamicResource UncadBodyStrong}" Text="I-line_Panel" />
                        <TextBlock Grid.Column="1" Style="{DynamicResource UncadBody}"
                                   Text="额外一行电盘（受“电盘”开关控制，不带断路器）" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{DynamicResource UncadBodyStrong}" Text="busbar connector" />
                        <TextBlock Grid.Column="1" Style="{DynamicResource UncadBody}"
                                   Text="只上色，不产生物料" />
                    </Grid>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
