<UserControl x:Class="UNCAD.UI.SettingsLogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:kit="clr-namespace:UNCAD.UI"
             FontFamily="Microsoft YaHei UI, Segoe UI">
    <!-- NavigationView 的 Frame 不继承窗口资源，设计令牌按页合并（2026-11-03）。 -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <kit:FluentKit />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,36,32">
        <StackPanel MaxWidth="920" HorizontalAlignment="Left">

            <TextBlock Style="{DynamicResource UncadPageTitle}" Text="日志与记录" />
            <TextBlock Margin="2,6,0,18" Style="{DynamicResource UncadCaption}"
                       Text="本地排障：日志级别与保留策略，以及最近的操作记录" />

            <!-- 日志策略 -->
            <ui:Card Style="{DynamicResource UncadCard}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource UncadSectionTitle}" Text="日志策略" />
                    <TextBlock Margin="0,4,0,12" Style="{DynamicResource UncadCaption}"
                               Text="日志文件位于 %APPDATA%\UNCAD\logs；级别越高写入越少。日志与操作记录只写本机，不会上传。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="日志级别" />
                            <ComboBox x:Name="LogLevel" x:FieldModifier="internal" Width="120"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="INFO" Tag="INFO" />
                                <ComboBoxItem Content="WARN" Tag="WARN" />
                                <ComboBoxItem Content="ERROR" Tag="ERROR" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,24,0">
                            <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="日志保留天数" />
                            <ui:NumberBox x:Name="LogRetentionDays" x:FieldModifier="internal"
                                          Style="{DynamicResource UncadNumberBox}" Width="120"
                                          Minimum="1" Maximum="3650" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="操作记录保留月数" />
                            <ui:NumberBox x:Name="HistoryRetentionMonths" x:FieldModifier="internal"
                                          Style="{DynamicResource UncadNumberBox}" Width="120"
                                          Minimum="1" Maximum="120" />
                        </StackPanel>
                        <ui:Button x:Name="OpenLogsButton" x:FieldModifier="internal"
                                   Grid.Column="3" Content="打开日志目录"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- 最近操作记录 -->
            <ui:Card Style="{DynamicResource UncadCard}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource UncadSectionTitle}" Text="最近操作记录" />
                    <TextBlock Margin="0,4,0,12" Style="{DynamicResource UncadCaption}"
                               Text="每次 U1F / U1U / U1S / U1DWG 等操作都会记一条；最多显示最近 200 条。" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:Button x:Name="OpenHistoryButton" x:FieldModifier="internal"
                                   Content="打开操作记录目录" />
                        <ui:Button x:Name="RefreshButton" x:FieldModifier="internal"
                                   Content="刷新记录" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="OperationStatus" x:FieldModifier="internal"
                               Style="{DynamicResource UncadCaption}" Margin="0,0,0,8"
                               Text="暂无操作记录。" />

                    <Border x:Name="OperationEmpty" x:FieldModifier="internal"
                            Padding="24,20,24,20" CornerRadius="4"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource UncadSectionTitle}"
                                       Text="还没有操作记录" />
                            <TextBlock Margin="0,6,0,0" Style="{DynamicResource UncadCaption}"
                                       Text="执行 U1F / U1U / U1S / U1DWG 等命令后，这里会按时间倒序列出最近操作。" />
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="OperationLogGrid" x:FieldModifier="internal"
                              MinHeight="160" MaxHeight="260"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" BorderThickness="0"
                              RowHeight="28" FontSize="12" SelectionMode="Single"
                              Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="150"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Header="命令" Binding="{Binding Command}" Width="90"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="84"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="*"
                                                MinWidth="220" IsReadOnly="True" />
                            <DataGridTextColumn Header="耗时(ms)" Binding="{Binding Duration}" Width="90"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
