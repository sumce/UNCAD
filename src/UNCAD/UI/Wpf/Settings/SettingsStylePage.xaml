<UserControl x:Class="UNCAD.UI.SettingsStylePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:kit="clr-namespace:UNCAD.UI"
             FontFamily="Microsoft YaHei UI, Segoe UI">
    <!-- NavigationView 的 Frame 不继承窗口资源，设计令牌按页合并（2026-11-03）。 -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Frame 资源黑洞（D-046 复盘）：页面必须自带 WPF-UI 字典，
                     否则 ToggleSwitch/NumberBox 退化为兜底模板（蓝条/无微调按钮）。
                     主题目前只在窗口构造时确定；若将来加运行时换肤，
                     需同步刷新各页的 ThemesDictionary。 -->
                <kit:FluentKit />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,36,32">
        <StackPanel MaxWidth="920" HorizontalAlignment="Left">

            <TextBlock Style="{DynamicResource UncadPageTitle}" Text="文字样式" />
            <TextBlock Margin="2,6,0,18" Style="{DynamicResource UncadCaption}"
                       Text="所有生成文字的公共样式" />

            <ui:Card Style="{DynamicResource UncadCard}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource UncadSectionTitle}" Text="文字样式" />
                    <TextBlock Margin="0,4,0,12" Style="{DynamicResource UncadCaption}"
                               Text="样式名与字体对所有生成文字生效；空字体表示使用当前样式。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,12">
                            <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="样式名" />
                            <ui:TextBox x:Name="StyleName" x:FieldModifier="internal"
                                        Style="{DynamicResource UncadFieldBox}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="字体文件（如 msyh.ttf）" />
                            <ui:TextBox x:Name="StyleFont" x:FieldModifier="internal"
                                        Style="{DynamicResource UncadFieldBox}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="大字体文件（空 = TTF）" />
                            <ui:TextBox x:Name="StyleBigFont" x:FieldModifier="internal"
                                        Style="{DynamicResource UncadFieldBox}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="宽高比" />
                            <ui:NumberBox x:Name="StyleWidth" x:FieldModifier="internal"
                                          Style="{DynamicResource UncadNumberBox}"
                                          Minimum="0.01" Maximum="100" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
