<UserControl x:Class="UNCAD.UI.SettingsStartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:kit="clr-namespace:UNCAD.UI"
             FontFamily="Microsoft YaHei UI, Segoe UI">
    <!-- NavigationView 的 Frame 不继承窗口资源，设计令牌按页合并（2026-11-03）。 -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Frame 资源黑洞（D-046 复盘）：页面必须自带 WPF-UI 字典，
                     否则 ToggleSwitch/NumberBox 退化为兜底模板（蓝条/无微调按钮）。
                     主题目前只在窗口构造时确定；若将来加运行时换肤，
                     需同步刷新各页的 ThemesDictionary。 -->
                <kit:FluentKit />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,36,32">
        <StackPanel MaxWidth="920" HorizontalAlignment="Left">

            <TextBlock Style="{DynamicResource UncadPageTitle}" Text="界面与启动" />
            <TextBlock Margin="2,6,0,18" Style="{DynamicResource UncadCaption}"
                       Text="启动表现与版本信息" />

            <ui:Card Style="{DynamicResource UncadCard}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource UncadSectionTitle}" Text="启动" />
                    <TextBlock Margin="0,4,0,4" Style="{DynamicResource UncadCaption}"
                               Text="打开 CAD 时是否播放全屏品牌动画。" />
                    <ui:ToggleSwitch x:Name="SplashEnabled" x:FieldModifier="internal"
                                     Style="{DynamicResource UncadToggle}"
                                     Content="启动时显示全屏品牌动画" />
                </StackPanel>
            </ui:Card>

            <ui:Card Style="{DynamicResource UncadCard}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource UncadSectionTitle}" Text="关于" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{DynamicResource UncadFieldLabel}" Margin="0" Text="产品" />
                        <TextBlock x:Name="ProductText" x:FieldModifier="internal"
                                   Grid.Column="1" FontSize="13" FontWeight="SemiBold" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{DynamicResource UncadFieldLabel}" Margin="0" Text="版本" />
                        <TextBlock x:Name="VersionText" x:FieldModifier="internal"
                                   Grid.Column="1" FontSize="13" FontWeight="SemiBold" />
                    </Grid>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
