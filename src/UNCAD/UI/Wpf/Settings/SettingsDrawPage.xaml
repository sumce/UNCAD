<UserControl x:Class="UNCAD.UI.SettingsDrawPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:kit="clr-namespace:UNCAD.UI"
             FontFamily="Microsoft YaHei UI, Segoe UI">
    <!-- NavigationView 的 Frame 不继承窗口资源，设计令牌按页合并（2026-11-03）。 -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Frame 资源黑洞（D-046 复盘）：页面必须自带 WPF-UI 字典，
                     否则 ToggleSwitch/NumberBox 退化为兜底模板（蓝条/无微调按钮）。
                     主题目前只在窗口构造时确定；若将来加运行时换肤，
                     需同步刷新各页的 ThemesDictionary。 -->
                <kit:FluentKit />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,36,32">
        <StackPanel MaxWidth="920" HorizontalAlignment="Left">

            <TextBlock Style="{DynamicResource UncadPageTitle}" Text="绘制标注" />
            <TextBlock Margin="2,6,0,18" Style="{DynamicResource UncadCaption}"
                       Text="U1L / U1Q / U1C / U1R 的默认标注参数" />

            <!-- 线段文字（U1L） -->
            <ui:Card Style="{DynamicResource UncadCard}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource UncadSectionTitle}" Text="线段文字（U1L）" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,12">
                            <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="占位文字" />
                            <ui:TextBox x:Name="UnlText" x:FieldModifier="internal"
                                        Style="{DynamicResource UncadFieldBox}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="文字高度" />
                            <ui:NumberBox x:Name="UnlHeight" x:FieldModifier="internal"
                                          Style="{DynamicResource UncadNumberBox}"
                                          Minimum="1" Maximum="100000" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="文字位置" />
                            <ComboBox x:Name="UnlPos" x:FieldModifier="internal"
                                      Style="{DynamicResource UncadCombo}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="居中" Tag="0" />
                                <ComboBoxItem Content="靠边下" Tag="1" />
                                <ComboBoxItem Content="靠边上" Tag="2" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="偏移距离（0 = 贴线）" />
                            <ui:NumberBox x:Name="UnlOffset" x:FieldModifier="internal"
                                          Style="{DynamicResource UncadNumberBox}"
                                          Minimum="0" Maximum="100000" />
                        </StackPanel>
                    </Grid>
                    <ui:ToggleSwitch x:Name="CorrectCableLabelPlacement"
                                     x:FieldModifier="internal"
                                     Style="{DynamicResource UncadToggle}"
                                     Margin="0,12,0,0"
                                     Content="U1F/U1U 矫正毫米标位置与角度"
                                     ToolTip="默认关闭。开启后只归位带 U1L 关联的毫米标，使用本页的位置和偏移设置；不改文字内容或字高。识别旧标注时允许最多 15° 的轻微角度偏差。" />
                </StackPanel>
            </ui:Card>

            <!-- 桥架文字与位置（U1Q） -->
            <ui:Card Style="{DynamicResource UncadCard}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource UncadSectionTitle}" Text="桥架文字与位置（U1Q）" />
                    <TextBlock Margin="0,4,0,12" Style="{DynamicResource UncadCaption}"
                               Text="规格由 U1Q1 / U1Q2 / U1Q4 分别固定为 100 / 200 / 400 桥架型号，本页只调整文字高度、偏移和标注侧。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,12">
                            <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="文字高度" />
                            <ui:NumberBox x:Name="UnqHeight" x:FieldModifier="internal"
                                          Style="{DynamicResource UncadNumberBox}"
                                          Minimum="1" Maximum="100000" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="红线距基线（0 = 15）" />
                            <ui:NumberBox x:Name="UnqLineOff" x:FieldModifier="internal"
                                          Style="{DynamicResource UncadNumberBox}"
                                          Minimum="0" Maximum="100000" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="文字距红线（0 = 贴线）" />
                            <ui:NumberBox x:Name="UnqTextOff" x:FieldModifier="internal"
                                          Style="{DynamicResource UncadNumberBox}"
                                          Minimum="0" Maximum="100000" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="标注侧" />
                            <ComboBox x:Name="UnqSide" x:FieldModifier="internal"
                                      Style="{DynamicResource UncadCombo}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="上方" Tag="1" />
                                <ComboBoxItem Content="下方" Tag="0" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- 线管规格（U1C） -->
            <ui:Card Style="{DynamicResource UncadCard}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource UncadSectionTitle}" Text="线管规格与位置（U1C）" />
                    <TextBlock Margin="0,4,0,12" Style="{DynamicResource UncadCaption}"
                               Text="文字高度与桥架共用；偏移和标注侧独立，默认与桥架同车道（上侧 15——有线管的线不会有桥架，不会重叠；连续段会合并为一趟标注）。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,12">
                            <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="默认管径" />
                            <ComboBox x:Name="ConduitDiameter" x:FieldModifier="internal"
                                      Style="{DynamicResource UncadCombo}" IsEditable="True">
                                <ComboBoxItem Content="20" />
                                <ComboBoxItem Content="25" />
                                <ComboBoxItem Content="38" />
                                <ComboBoxItem Content="51" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="紫线距基线（0 = 15）" />
                            <ui:NumberBox x:Name="ConduitLineOff" x:FieldModifier="internal"
                                          Style="{DynamicResource UncadNumberBox}"
                                          Minimum="0" Maximum="100000" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="文字距紫线（0 = 贴线）" />
                            <ui:NumberBox x:Name="ConduitTextOff" x:FieldModifier="internal"
                                          Style="{DynamicResource UncadNumberBox}"
                                          Minimum="0" Maximum="100000" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="标注侧" />
                            <ComboBox x:Name="ConduitSide" x:FieldModifier="internal"
                                      Style="{DynamicResource UncadCombo}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="上方" Tag="1" />
                                <ComboBoxItem Content="下方" Tag="0" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- 拱桥开洞（U1R） -->
            <ui:Card Style="{DynamicResource UncadCard}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource UncadSectionTitle}" Text="拱桥开洞（U1R）" />
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="拱桥直径" />
                        <ui:NumberBox x:Name="UnrDiameter" x:FieldModifier="internal"
                                      Style="{DynamicResource UncadNumberBox}"
                                      Minimum="1" Maximum="100000" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- 绘制软管（U1B，3.3.3） -->
            <ui:Card Style="{DynamicResource UncadCard}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource UncadSectionTitle}" Text="绘制软管（U1B）" />
                    <TextBlock Margin="0,4,0,12" Style="{DynamicResource UncadCaption}"
                               Text="管子绿色绘制在 U_HOSE 图层，拐弯圆弧过渡、首尾半圆端帽；标注文字高度与线段文字共用。" />
                    <StackPanel>
                        <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="软管直径" />
                        <ui:NumberBox x:Name="HoseDiameter" x:FieldModifier="internal"
                                      Style="{DynamicResource UncadNumberBox}"
                                      Minimum="1" Maximum="1000" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Xauto 布局占用率 -->
            <ui:Card Style="{DynamicResource UncadCard}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource UncadSectionTitle}" Text="自动布局（Xauto）" />
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Style="{DynamicResource UncadFieldLabel}" Text="图框占用比例（0.2–1.0）" />
                        <ui:NumberBox x:Name="XAutoFillRatio" x:FieldModifier="internal"
                                      Style="{DynamicResource UncadNumberBox}"
                                      Minimum="0.2" Maximum="1.0"
                                      ToolTip="1.0 按图框可用区域铺满；较小值会留出更多空白。" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- 3D 预览参照层（U1U，3.3.6；3.3.7 类型化模型） -->
            <ui:Card Style="{DynamicResource UncadCard}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource UncadSectionTitle}" Text="3D 预览参照层（U1U）" />
                    <TextBlock Margin="0,4,0,12" Style="{DynamicResource UncadCaption}"
                               Text="U1U 确认窗 3D 预览里画出的参照物（建筑标高/设备高度），供电缆爬升高度对照。格式：标签=毫米=类型=锚定（后两段可选）——类型：地面/环氧地坪/华夫板/工字钢/葡萄架/高架地板/设备/母线（缺省只画标高线框）；锚定：高度相对该条目起算（如母线 3660 锚「2F地面」=7800+3660）；可选指令行「本层=2F地面」=机台所在楼层，整栋楼按本层重定位（本层地面=场景 0，母线/设备画在本层）。楼层标高链按累计折算；分号或换行分隔，非法条目自动跳过；清空=不画。钢梁/葡萄架默认隐藏（页面「结构」开关）。" />
                    <ui:TextBox x:Name="PreviewReferenceLevels" x:FieldModifier="internal"
                                Style="{DynamicResource UncadFieldBox}"
                                AcceptsReturn="True" TextWrapping="Wrap"
                                MinHeight="96" MaxHeight="160"
                                VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
