<ui:FluentWindow x:Class="UNCAD.UI.BatchFillConfirmationWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:UNCAD.UI"
                 Title="U1U 批量确认"
                 Width="1180" Height="680" MinWidth="900" MinHeight="520"
                 FontFamily="Microsoft YaHei UI, Segoe UI"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="U1U 批量确认" />

        <Grid x:Name="BodyGrid" Grid.Row="1" Margin="24,12,24,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!-- 3.3.1（D-054 Amendment）：预览与清单对半分（两个 Star 列 +
                     GridSplitter 可拖，最小宽度保护）；无预建场景时预览列宽回
                     0、分隔条隐藏。3.3.0 的固定 320px 窄条已废弃。 -->
                <ColumnDefinition x:Name="PreviewColumn" Width="0" MinWidth="0" />
                <ColumnDefinition x:Name="PreviewSplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="ReviewColumn" Width="*" MinWidth="250" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.ColumnSpan="3" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="{Binding Heading, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}, Mode=OneWay}" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,12" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="所有图框将在一个事务中写入，任一失败则整批回滚；请逐行核对机台和回路。选中一行，左侧预览该图框的 U1L 路由（左键拖动旋转/滚轮缩放/右键拖动平移/双击复位）。" />
            <Border x:Name="PreviewHost" Grid.Row="2" Grid.Column="0" Margin="0,0,6,0"
                    Visibility="Collapsed"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6">
                <local:QuickLineOrbitPreviewControl x:Name="OrbitPreview" />
            </Border>
            <GridSplitter x:Name="PreviewSplitter" Grid.Row="2" Grid.Column="1" Width="6"
                          Visibility="Collapsed" Background="Transparent"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Cursor="SizeWE" />
            <DataGrid x:Name="BatchGrid" Grid.Row="2" Grid.Column="2"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" BorderThickness="0"
                      RowHeight="28" FontSize="12"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      SelectionChanged="OnGridSelectionChanged"
                      Background="{DynamicResource ControlFillColorDefaultBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="图框" Binding="{Binding FrameHandle}" Width="80" />
                    <DataGridTextColumn Header="机台 ID" Binding="{Binding MachineId}" Width="110" />
                    <DataGridTextColumn Header="设备 / 回路" Binding="{Binding DeviceName}" Width="*" >
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding DeviceName}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="上游编号" Binding="{Binding UpstreamId}" Width="170">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding UpstreamId}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="厂务开关" Binding="{Binding FacilitySwitch}" Width="95" />
                    <DataGridTextColumn Header="Device" Binding="{Binding DeviceState}" Width="100" />
                    <DataGridTextColumn Header="连通性" Binding="{Binding ConnectivityText}" Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding ConnectivityText}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="清单项" Binding="{Binding RowCount}" Width="64">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <!-- D-056：选中行详情条（默认收起；点名同名回路差异字段）。 -->
            <Grid x:Name="DetailStrip" Grid.Row="3" Grid.ColumnSpan="3" Margin="0,8,0,0"
                  Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="DetailToggle" Grid.Column="0" Margin="0,0,8,0"
                              Content="详情 ▴" FontSize="12" Click="OnDetailToggle" />
                <TextBlock x:Name="DetailText" Grid.Column="1" FontSize="11"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="24,8,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding Footer, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}, Mode=OneWay}" />
                <!-- 3.3.0（D-054 特性①）：图层矫正报告（有计划才显示）。 -->
                <TextBlock x:Name="LayerGovernorText" FontSize="12" Margin="0,2,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ui:Button x:Name="CancelButton" Grid.Column="1" Content="取消" MinWidth="110"
                       Margin="0,0,12,0" IsCancel="True" Click="OnCancel" />
            <ui:Button x:Name="ConfirmButton" Grid.Column="2" Content="确认更新" MinWidth="110"
                       IsDefault="True" Appearance="Primary"
                       Icon="{ui:SymbolIcon Checkmark24}" Click="OnConfirm" />
        </Grid>
    </Grid>
</ui:FluentWindow>
