<ui:FluentWindow x:Class="UNCAD.UI.CircuitAmbiguityWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="选择同名回路"
                 Width="980" Height="540" MinWidth="780" MinHeight="420"
                 FontFamily="Microsoft YaHei UI, Segoe UI"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="选择同名回路" />

        <Grid Grid.Row="1" Margin="24,12,24,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="{Binding Heading, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}, Mode=OneWay}" />
            <TextBlock Grid.Row="1" Margin="0,6,0,10" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding Caption, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}, Mode=OneWay}" />
            <DataGrid x:Name="CandidateGrid" Grid.Row="2"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" BorderThickness="0"
                      RowHeight="26" FontSize="12"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      MouseDoubleClick="OnGridDoubleClick"
                      SelectionChanged="OnGridSelectionChanged"
                      Background="{DynamicResource ControlFillColorDefaultBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="回路名称" Binding="{Binding CircuitName}" Width="*" />
                    <DataGridTextColumn Header="上游编号" Binding="{Binding UpstreamId}" Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding UpstreamId}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="厂务开关" Binding="{Binding FacilitySwitch}" Width="110" />
                    <DataGridTextColumn Header="电缆型号" Binding="{Binding Cable}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding Cable}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="楼层 · 轴位" Binding="{Binding FloorAxis}" Width="110" />
                    <DataGridTextColumn Header="上游类型" Binding="{Binding UpstreamType}" Width="100" />
                    <DataGridTextColumn Header="批次" Binding="{Binding Batch}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>
            <!-- 选中行全字段详情：同名回路的差异字段一眼可比（D-056）。 -->
            <Border Grid.Row="3" Margin="0,8,0,0" Padding="10,6"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4">
                <TextBlock x:Name="DetailText" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="24,8,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="双击行或点“确认选择”继续；取消则本次不更新该图框。" />
            <ui:Button x:Name="CancelButton" Grid.Column="1" Content="取消" MinWidth="100"
                       Margin="0,0,12,0" IsCancel="True" Click="OnCancel" />
            <ui:Button x:Name="ConfirmButton" Grid.Column="2" Content="确认选择" MinWidth="110"
                       IsDefault="True" Appearance="Primary"
                       Icon="{ui:SymbolIcon Checkmark24}" Click="OnConfirm" />
        </Grid>
    </Grid>
</ui:FluentWindow>
