<ui:FluentWindow x:Class="UNCAD.UI.ProgressWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="处理进度"
                 Width="460" Height="168" ResizeMode="NoResize"
                 WindowStartupLocation="Manual" Left="80" Top="80"
                 ShowInTaskbar="False" Topmost="True"
                 FontFamily="Microsoft YaHei UI, Segoe UI"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Text="处理进度" />
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,8,0,10" FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="准备中…" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="Bar" Grid.Column="0" Height="14"
                         Minimum="0" Maximum="100" Value="0" />
            <TextBlock x:Name="CountText" Grid.Column="1" Margin="10,0,0,0"
                       VerticalAlignment="Center" FontSize="12"
                       FontFamily="Cascadia Mono, Consolas"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="0 / 0" />
        </Grid>
    </Grid>
</ui:FluentWindow>
